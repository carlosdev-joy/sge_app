# .env — Variáveis de ambiente de PRODUÇÃO
# Copie para .env e preencha antes de `docker compose up`.
# NUNCA commite o .env com dados reais.

# ── Airflow UID ───────────────────────────────────────────────────────────────
AIRFLOW_UID=0

# ── Diretório base do projeto ─────────────────────────────────────────────────
AIRFLOW_PROJ_DIR=.

# ── Fernet / chaves de sessão ────────────────────────────────────────────────
# Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__WEBSERVER__SECRET_KEY=
ORQUESTRA_CONN_KEY=

# ── Banco SQL Server (produção) ──────────────────────────────────────────────
MSSQL_SERVER=sql14\dmcvp
MSSQL_DATABASE=DMDB41
MSSQL_USER=usr_dstage_prev
MSSQL_PASSWORD=

# ── DataStage SSH (console Admin — leitura) ──────────────────────────────────
DS_SSH_HOST=
DS_SSH_PORT=22
DS_SSH_USER=
DS_SSH_PASSWORD=
DS_SSH_KEY_FILE=
DS_DSHOME=/opt/IBM/InformationServer/Server/DSEngine

# ── CORS (origens permitidas na API) ─────────────────────────────────────────
CORS_ORIGINS=http://orquestra.caixavidaeprevidencia.intranet,http://orquestra.caixavidaeprevidencia.intranet:8090,http://vmlnxprd083,http://vmlnxprd083:8090

# ── ServiceNow ───────────────────────────────────────────────────────────────
# URL base da instância. Usada como default na tela Admin e nas DAGs de sync.
SERVICENOW_URL=https://cvpsnprod.service-now.com

# Proxy corporativo para acesso externo ao ServiceNow.
# O httpx/requests lê estas variáveis automaticamente (trust_env=True).
# Vazio = sem proxy (conexão direta).
HTTPS_PROXY=http://webproxycvp.adcorp.intranet/
HTTP_PROXY=http://webproxycvp.adcorp.intranet/
NO_PROXY=localhost,127.0.0.1,orquestra-api,airflow-webserver

# NOTA: usuário, senha e demais parâmetros do sync ServiceNow NÃO ficam aqui.
# Eles são configurados pela tela Admin > ServiceNow > Configuração e gravados
# criptografados na tabela etl_app_config (migration 099_servicenow_config_seed.sql).
# Chaves gerenciadas via Admin:
#   servicenow_usuario   → Conta de serviço (ex: user.power_bi)
#   servicenow_senha_enc → Senha cifrada com Fernet (ORQUESTRA_CONN_KEY)
#   servicenow_habilitado→ "1" ativa o sync delta/full
#   servicenow_proxy     → Proxy por instância (sobrepõe HTTPS_PROXY para o sync)
#   servicenow_grupos    → Grupo de atribuição a monitorar (ex: TI_CVP_GERESD_ED)
