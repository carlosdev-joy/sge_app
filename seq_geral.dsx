   BEGIN DSRECORD
      Identifier "BiCvp_BaseCobranca_02_ext_Parcelas_Clientes.EXT_PARCELAS_CLIENTES"
      F1 "STAGE"
      F2 "CUSTOM"
      F3 "11.7///60/C"
      F4 "BiCvp_BaseCobranca_02_ext_Parcelas_Clientes"
      F10 "BiCvp_BaseCobranca_02_ext_Parcelas_Clientes.EXT_PARCELAS_CLIENTES.LnkParcelasPagas"
      F13 "VariantName\VVariantLibrary\VVariantVersion\VSupportedVariants\VSupportedVariantsLibraries\VSupportedVariantsVersions\VOrientation\VRejectFromLink\VRejectThreshold\VRejectNumber\VRejectUsesPercentage\VConnectorName\VEngine\VContext\VConnectionString\VUsername\VPassword\VXMLProperties"
      F14 "3.5\Vccodbc\V1.0\VV1;3.5::ccodbc\Vccodbc\V1.0\Vlink\V-1\V0\V0\Vfalse\VODBCConnector\VEE\Vsource\V/Connection/DataSource\V/Connection/Username\V/Connection/Password\V<?xml version='1.0' encoding='UTF-16'?><Properties version='1.1'><Common><Context type='int'>1</Context><Variant type='string'>3.5</Variant><DescriptorVersion type='string'>1.0</DescriptorVersion><PartitionType type='int'>-1</PartitionType><RCP type='int'>0</RCP></Common><Connection><DataSource modified='1' type='string'><![CDATA[#SSD_DIROT.ParmDbNameDBBUCC#]]></DataSource><Username modified='1' type='string'><![CDATA[#SSD_DIROT.ParmDbUserDBBUCC#]]></Username><Password modified='1' type='string'><![CDATA[#SSD_DIROT.ParmDbPassDBBUCC#]]></Password></Connection><Usage><GenerateSQL type='bool'><![CDATA[0]]></GenerateSQL><EnableQuotedIDs type='bool'><![CDATA[0]]></EnableQuotedIDs><SQL><SelectStatement modified='1' type='string'><![CDATA[WITH Parcelas AS (\(D)\(A)    SELECT\(D)\(A)        A.NUM_CERTIFICADO,\(D)\(A)        A.NUM_PARCELA,\(D)\(A)        ROW_NUMBER() OVER (PARTITION BY A.NUM_CERTIFICADO ORDER BY A.NUM_PARCELA) AS rn\(D)\(A)    FROM dbo.DM_COBRANCA_CVP A\(D)\(A)    INNER JOIN DM_CONTRATOS_CVP B\(D)\(A)        ON A.NUM_CERTIFICADO = B.NUM_CERTIFICADO\(D)\(A)        AND B.NOM_SEGMENTO IN ('VIDA', 'PREVIDENCIA')\(D)\(A)        AND B.DES_SITUACAO IN ('Ativo', 'Ativa com Cobran\(E7)a')\(D)\(A)\(D)\(A)    LEFT JOIN VW_PRODUTOS_CVP E\(D)\(A)        ON B.COD_PRODUTO_COMPLETO = E.COD_PRODUTO_COMPLETO\(D)\(A)\(D)\(A)    -- >>> JOIN NECESS\(C1)RIO PARA VIDA\(D)\(A)    LEFT JOIN dbo.TB_PARCELA_PAG P\(D)\(A)        ON A.NOM_SEGMENTO = 'VIDA'\(D)\(A)       AND P.NUM_CERTIFICADO = A.NUM_CERTIFICADO\(D)\(A)       AND P.NUM_PARCELA     = A.NUM_PARCELA\(D)\(A)\(D)\(A)    WHERE A.NOM_SEGMENTO IN ('VIDA', 'PREVIDENCIA')\(D)\(A)      AND (E.DES_TIPO_SEGMENTO <> 'Bilhete + Microsseguro' OR E.DES_TIPO_SEGMENTO IS NULL)\(D)\(A)      AND E.COD_PRODUTO NOT IN (9386, 9311, 9354, 8203, 9305)\(D)\(A)\(D)\(A)      AND (A.DES_SIT_COBRANCA IN ('Inadimplente', 'Cancelada por Inadimplencia')\(D)\(A)           OR A.DES_SIT_PARCELA IN ('PENDENTE', 'CANCELADO'))\(D)\(A)\(D)\(A)      AND (\(D)\(A)            (A.NOM_SEGMENTO = 'PREVIDENCIA' AND E.DES_TIPO_PRODUTO <> 'EMPRESARIAL')\(D)\(A)            OR\(D)\(A)            (A.NOM_SEGMENTO = 'VIDA' AND E.DES_TIPO_SEGMENTO IN ('PF', 'PJ'))\(D)\(A)          )\(D)\(A)\(D)\(A)      AND A.DES_SIT_PARCELA = 'PENDENTE'\(D)\(A)\(D)\(A)      -- ? PER\(CD)ODO AJUSTADO (VIDA usa TB_PARCELA_PAG)\(D)\(A)      AND CONVERT(date,\(D)\(A)            CASE \(D)\(A)                WHEN A.NOM_SEGMENTO = 'VIDA' THEN P.DATA_VENCIMENTO\(D)\(A)                ELSE A.dth_vencimento\(D)\(A)            END\(D)\(A)      ) > CONVERT(date, GETDATE() - 120)\(D)\(A)\(D)\(A)      AND CONVERT(date,\(D)\(A)            CASE \(D)\(A)                WHEN A.NOM_SEGMENTO = 'VIDA' THEN P.DATA_VENCIMENTO\(D)\(A)                ELSE A.dth_vencimento\(D)\(A)            END\(D)\(A)      ) < CONVERT(date, GETDATE())\(D)\(A)\(D)\(A)      -- ? REGRA D+7 / D+9 AJUSTADA\(D)\(A)      AND CAST(GETDATE() AS date) >          DATEADD(DAY,\(D)\(A)              CASE\(D)\(A)                  WHEN A.nom_forma_pagamento LIKE '%FICHA%' THEN 11--- PRAZO CORRETO 9 - EM VALIDACAO DEIXAR 11\(D)\(A)                  WHEN A.nom_forma_pagamento LIKE '%DEBITO%' \(D)\(A)                    OR A.nom_forma_pagamento LIKE '%D\(C9)BITO%' \(D)\(A)                    OR A.nom_forma_pagamento LIKE '%Combo%' THEN 9 --- PRAZO CORRETO 7 - EM VALIDACAO DEIXAR 9\(D)\(A)                  ELSE 0\(D)\(A)              END,\(D)\(A)              CONVERT(date,\(D)\(A)                  CASE \(D)\(A)                      WHEN A.NOM_SEGMENTO = 'VIDA' THEN P.DATA_VENCIMENTO\(D)\(A)                      ELSE A.dth_vencimento\(D)\(A)                  END\(D)\(A)              )\(D)\(A)          )\(D)\(A)\(D)\(A)      -- ? VIDA tem que existir na TB_PARCELA_PAG\(D)\(A)      AND (\(D)\(A)            A.NOM_SEGMENTO <> 'VIDA'\(D)\(A)            OR P.NUM_CERTIFICADO IS NOT NULL\(D)\(A)          )\(D)\(A))\(D)\(A)\(D)\(A), Blocos AS (\(D)\(A)    SELECT\(D)\(A)        NUM_CERTIFICADO,\(D)\(A)        NUM_PARCELA,\(D)\(A)        rn,\(D)\(A)        NUM_PARCELA - rn AS bloco_id\(D)\(A)    FROM Parcelas\(D)\(A))\(D)\(A)\(D)\(A), ParcelasSequenciais AS (\(D)\(A)    SELECT\(D)\(A)        NUM_CERTIFICADO, \(D)\(A)        NUM_PARCELA,\(D)\(A)        bloco_id,\(D)\(A)        COUNT(*) OVER (PARTITION BY NUM_CERTIFICADO, bloco_id) AS tamanho_bloco\(D)\(A)    FROM Blocos\(D)\(A))\(D)\(A)\(D)\(A), ParcelasValidas AS (\(D)\(A)    SELECT\(D)\(A)        NUM_CERTIFICADO,\(D)\(A)        NUM_PARCELA,\(D)\(A)        bloco_id,\(D)\(A)        tamanho_bloco\(D)\(A)    FROM ParcelasSequenciais\(D)\(A)    WHERE tamanho_bloco >= 1\(D)\(A))\(D)\(A)\(D)\(A)SELECT DISTINCT\(D)\(A)    A.NOM_SEGMENTO AS segmento,\(D)\(A)    B.COD_AGENCIA AS codAgencia,\(D)\(A)    A.NUM_CERTIFICADO AS numeroContrato,\(D)\(A)    A.NUM_PARCELA as NumeroParcela,\(D)\(A)    ISNULL(B.VLR_ATUAL_CONTRIBUICAO, A.VLR_PREMIO_PARCELA) AS valorProposta,\(D)\(A)\(D)\(A)    -- ? CAMPO ORIGINAL PRESERVADO (somente fonte alterada)\(D)\(A)    CONVERT(DATE,\(D)\(A)        CASE\(D)\(A)            WHEN A.NOM_SEGMENTO = 'VIDA' THEN P.DATA_VENCIMENTO\(D)\(A)            ELSE A.dth_vencimento\(D)\(A)        END\(D)\(A)    ) AS DataVencimentoParcela,\(D)\(A)\(D)\(A)    CASE\(D)\(A)      WHEN A.nom_forma_pagamento LIKE '%DEBITO%' THEN 'Debito em Conta'\(D)\(A)      WHEN A.nom_forma_pagamento LIKE '%D\(C9)BITO%' THEN 'Debito em Conta'\(D)\(A)      WHEN A.nom_forma_pagamento LIKE '%FICHA%' THEN 'Boleto'\(D)\(A)      WHEN A.nom_forma_pagamento LIKE '%Combo%' THEN 'Debito em Conta'\(D)\(A)      ELSE A.nom_forma_pagamento\(D)\(A)    END AS formaPagamento,\(D)\(A)\(D)\(A)    B.IND_PERIODICIDADE_COBRANCA AS opcaoPagamento,\(D)\(A)    A.COD_AGENCIA AS AgenciaCob,\(D)\(A)    A.cod_Operacao AS CodOperacaoCob,\(D)\(A)    A.num_Conta AS NumContaCob,\(D)\(A)    A.cod_idlg AS Idlg,\(D)\(A)    '' AS NumeroCartaoCredito,\(D)\(A)    D.NOM_LOGRADOURO AS logradouro,\(D)\(A)    D.NUM_LOGRADOURO AS Numlogradouro,\(D)\(A)    D.DES_COMPL_ENDERECO AS ComplEndereco,\(D)\(A)    D.NOM_BAIRRO AS Bairro,\(D)\(A)    D.NOM_CIDADE AS Cidade,\(D)\(A)    D.COD_UF AS Uf,\(D)\(A)\(D)\(A)    D.NOM_PESSOA,\(D)\(A)    D.NUM_CPF_CNPJ AS codCpfCnpj,\(D)\(A)    E.DES_PRODUTO AS nomeProduto,\(D)\(A)    A.ULT_COBRANCA AS dataHoraUltimaCob,\(D)\(A)\(D)\(A)    CASE\(D)\(A)      WHEN A.NOM_SEGMENTO = 'PREVIDENCIA' THEN FLOOR(DATEDIFF(MONTH, B.DTA_INICIO_VIGENCIA, GETDATE()))\(D)\(A)      WHEN A.NOM_SEGMENTO = 'VIDA' THEN FLOOR(DATEDIFF(MONTH, B.DTA_QUITACAO, GETDATE()))\(D)\(A)      ELSE NULL\(D)\(A)    END AS TempoContrato,\(D)\(A)\(D)\(A)    E.IND_CONJUGADO AS Comunicabilidade,\(D)\(A)\(D)\(A)    CASE\(D)\(A)      WHEN ben.NOM_PESSOA IN ('HERDEIROS LEGAIS') THEN 'N\(E3)o'\(D)\(A)      WHEN ben.NOM_PESSOA IS NULL THEN 'N\(E3)o'\(D)\(A)      ELSE 'Sim'\(D)\(A)    END as benficiariosExistentes\(D)\(A)\(D)\(A)FROM dbo.DM_COBRANCA_CVP A\(D)\(A)INNER JOIN DM_CONTRATOS_CVP B\(D)\(A)    ON A.NUM_CERTIFICADO = B.NUM_CERTIFICADO\(D)\(A)INNER JOIN (\(D)\(A)    SELECT *\(D)\(A)    FROM (\(D)\(A)        SELECT \(D)\(A)            *,\(D)\(A)            ROW_NUMBER() OVER (\(D)\(A)                PARTITION BY NUM_CERTIFICADO \(D)\(A)                ORDER BY \(D)\(A)                    CASE \(D)\(A)                        WHEN NOM_LOGRADOURO IS NOT NULL AND NOM_LOGRADOURO <> 'N\(C3)O SE APLICA' THEN 1\(D)\(A)                        ELSE 2\(D)\(A)                    END,\(D)\(A)                    NOM_PESSOA\(D)\(A)            ) AS rn\(D)\(A)        FROM DM_CLIENTES_CONTRATOS_CVP\(D)\(A)\(9)WHERE 1=1 \(D)\(A)\(9)\(9)AND COD_PESSOA = 1\(D)\(A)    ) X\(D)\(A)    WHERE rn = 1\(D)\(A)) D\(D)\(A)ON B.NUM_CERTIFICADO = D.NUM_CERTIFICADO\(D)\(A)INNER JOIN DM_CLIENTES_UNIFICADOS_CVP F\(D)\(A)    ON D.NUM_CPF_CNPJ = F.NUM_CPF_CNPJ\(D)\(A)\(D)\(A)LEFT JOIN VW_PRODUTOS_CVP E\(D)\(A)    ON B.COD_PRODUTO_COMPLETO = E.COD_PRODUTO_COMPLETO\(D)\(A)\(D)\(A)LEFT JOIN DM_BENEFICIARIOS_CONTRATOS_CVP ben\(D)\(A)    ON ben.NUM_CERTIFICADO = A.NUM_CERTIFICADO\(D)\(A)   AND ben.NOM_SEGMENTO = A.NOM_SEGMENTO\(D)\(A)\(D)\(A)-- ? JOIN VIDA\(D)\(A)LEFT JOIN dbo.TB_PARCELA_PAG P\(D)\(A)    ON A.NOM_SEGMENTO = 'VIDA'\(D)\(A)   AND P.NUM_CERTIFICADO = A.NUM_CERTIFICADO\(D)\(A)   AND P.NUM_PARCELA     = A.NUM_PARCELA\(D)\(A)\(D)\(A)INNER JOIN ParcelasValidas PS\(D)\(A)    ON A.NUM_CERTIFICADO = PS.NUM_CERTIFICADO\(D)\(A)   AND A.NUM_PARCELA = PS.NUM_PARCELA\(D)\(A)\(D)\(A)WHERE \(D)\(A)    A.NOM_SEGMENTO IN ('VIDA', 'PREVIDENCIA')\(D)\(A)\(D)\(A)    -- ? REGRA D+7 / D+9\(D)\(A)    AND CAST(GETDATE() AS date) >        DATEADD(DAY,\(D)\(A)            CASE\(D)\(A)                  WHEN A.nom_forma_pagamento LIKE '%FICHA%' THEN 11--- PRAZO CORRETO 9 - EM VALIDACAO DEIXAR 11\(D)\(A)                  WHEN A.nom_forma_pagamento LIKE '%DEBITO%' \(D)\(A)                    OR A.nom_forma_pagamento LIKE '%D\(C9)BITO%' \(D)\(A)                    OR A.nom_forma_pagamento LIKE '%Combo%' THEN 9 --- PRAZO CORRETO 7 - EM VALIDACAO DEIXAR 9\(D)\(A)                ELSE 0\(D)\(A)            END,\(D)\(A)            CONVERT(date,\(D)\(A)                CASE\(D)\(A)                    WHEN A.NOM_SEGMENTO = 'VIDA' THEN P.DATA_VENCIMENTO\(D)\(A)                    ELSE A.dth_vencimento\(D)\(A)                END\(D)\(A)            )\(D)\(A)        )\(D)\(A)\(D)\(A)    -- ? REGRA VIDA\(D)\(A)    AND (\(D)\(A)          A.NOM_SEGMENTO <> 'VIDA'\(D)\(A)          OR P.NUM_CERTIFICADO IS NOT NULL\(D)\(A)        )]]><ReadStatementFromFile type='bool'><![CDATA[0]]></ReadStatementFromFile><Tables collapsed='1'></Tables><Parameters collapsed='1'></Parameters><Columns collapsed='1'></Columns></SelectStatement><EnablePartitioning collapsed='1' type='bool'><![CDATA[0]]></EnablePartitioning></SQL><Transaction><RecordCount modified='1' type='int'><![CDATA[4000]]></RecordCount><EndOfWave collapsed='1' type='int'><![CDATA[0]]></E