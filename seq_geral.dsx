#!/bin/sh
# Shell script for Datastage to execute an osh script, generated at 2026-05-21 18:05:05
# Compiler runtime stamp 11.7///60/C
#
# Parameters:
# $1 - Run indicator: R=normal run, P=performance wrappered run
# $2 - Environment variable file name - dummy
# $3... - Osh / performance checker command line arguments
RunIndicator=$1
DummyEnv=$2
shift
shift
if test ! -x "$APT_ORCHHOME/bin/osh"
  then echo '##OSHRETVAL NOOSH'
  exit 1
fi
# Test for resource estimation option.
if test $RunIndicator = P
  then $APT_ORCHHOME/bin/orchresest "$@" 2>&1 &
  else $APT_ORCHHOME/bin/osh "$@" 2>&1 &
fi
oshpid=$!
# Write the pid of the conductor process
echo '##OSHPID' $oshpid
wait $oshpid
oshcode=$?
oshdir=`dirname $0`
# Write the terminating string
echo '##OSHRETVAL' $oshcode > $oshdir/../RT_SCTEMP/$oshpid.retval
echo '##OSHRETVAL' $oshcode
# end of script
=+=+=+=
   END DSSCRIPT
   BEGIN DSSCRIPT
      Identifier "OshScript.osh"
      TERMINATOR =+=+=+=
# OSH / orchestrate script for Job BiCvp_BaseCobranca_02_ext_Parcelas_Clientes compiled at 18:05:05 21 May 2026
#################################################################
#### STAGE: DS_EXT_PARCELAS_CLIENTES
## Operator
copy
## General options
[ident('DS_EXT_PARCELAS_CLIENTES')]
## Inputs
0< [] 'EXT_PARCELAS_CLIENTES:LnkParcelasPagas.v'
## Outputs
0>| [ds] '[&\"SSD_DIROT.ParmDirDst\"]/DS_EXT_PARCELAS_CLIENTES.dx'
;
#################################################################
#### STAGE: EXT_PARCELAS_CLIENTES
## Operator
pxbridge
## Operator options
-Orientation link
-XMLProperties '<?xml version=\\'1.0\\' encoding=\\'UTF-16\\'?><Properties version=\\'1.1\\'><Common><Context type=\\'int\\'>1</Context><Variant type=\\'string\\'>3.5</Variant><DescriptorVersion type=\\'string\\'>1.0</DescriptorVersion><PartitionType type=\\'int\\'>-1</PartitionType><RCP type=\\'int\\'>0</RCP></Common><Connection><DataSource modified=\\'1\\' type=\\'string\\'><![CDATA[[&\"SSD_DIROT.ParmDbNameDBBUCC\"]]]></DataSource><Username modified=\\'1\\' type=\\'string\\'><![CDATA[[&\"SSD_DIROT.ParmDbUserDBBUCC\"]]]></Username><Password modified=\\'1\\' type=\\'string\\'><![CDATA[[&\"SSD_DIROT.ParmDbPassDBBUCC\"]]]></Password></Connection><Usage><GenerateSQL type=\\'bool\\'><![CDATA[0]]></GenerateSQL><EnableQuotedIDs type=\\'bool\\'><![CDATA[0]]></EnableQuotedIDs><SQL><SelectStatement modified=\\'1\\' type=\\'string\\'><![CDATA[WITH Parcelas AS (
    SELECT
        A.NUM_CERTIFICADO,
        A.NUM_PARCELA,
        ROW_NUMBER() OVER (PARTITION BY A.NUM_CERTIFICADO ORDER BY A.NUM_PARCELA) AS rn
    FROM dbo.DM_COBRANCA_CVP A
    INNER JOIN DM_CONTRATOS_CVP B
        ON A.NUM_CERTIFICADO = B.NUM_CERTIFICADO
        AND B.NOM_SEGMENTO IN (\\'VIDA\\', \\'PREVIDENCIA\\')
        AND B.DES_SITUACAO IN (\\'Ativo\\', \\'Ativa com Cobran\(E7)a\\')
    LEFT JOIN VW_PRODUTOS_CVP E
        ON B.COD_PRODUTO_COMPLETO = E.COD_PRODUTO_COMPLETO
    -- >>> JOIN NECESS\(C1)RIO PARA VIDA
    LEFT JOIN dbo.TB_PARCELA_PAG P
        ON A.NOM_SEGMENTO = \\'VIDA\\'
       AND P.NUM_CERTIFICADO = A.NUM_CERTIFICADO
       AND P.NUM_PARCELA     = A.NUM_PARCELA
    WHERE A.NOM_SEGMENTO IN (\\'VIDA\\', \\'PREVIDENCIA\\')
      AND (E.DES_TIPO_SEGMENTO <> \\'Bilhete + Microsseguro\\' OR E.DES_TIPO_SEGMENTO IS NULL)
      AND E.COD_PRODUTO NOT IN (9386, 9311, 9354, 8203, 9305)
      AND (A.DES_SIT_COBRANCA IN (\\'Inadimplente\\', \\'Cancelada por Inadimplencia\\')
           OR A.DES_SIT_PARCELA IN (\\'PENDENTE\\', \\'CANCELADO\\'))
      AND (
            (A.NOM_SEGMENTO = \\'PREVIDENCIA\\' AND E.DES_TIPO_PRODUTO <> \\'EMPRESARIAL\\')
            OR
            (A.NOM_SEGMENTO = \\'VIDA\\' AND E.DES_TIPO_SEGMENTO IN (\\'PF\\', \\'PJ\\'))
          )
      AND A.DES_SIT_PARCELA = \\'PENDENTE\\'
      -- ? PER\(CD)ODO AJUSTADO (VIDA usa TB_PARCELA_PAG)
      AND CONVERT(date,
            CASE 
                WHEN A.NOM_SEGMENTO = \\'VIDA\\' THEN P.DATA_VENCIMENTO
                ELSE A.dth_vencimento
            END
      ) > CONVERT(date, GETDATE() - 120)
      AND CONVERT(date,
            CASE 
                WHEN A.NOM_SEGMENTO = \\'VIDA\\' THEN P.DATA_VENCIMENTO
                ELSE A.dth_vencimento
            END
      ) < CONVERT(date, GETDATE())
      -- ? REGRA D+7 / D+9 AJUSTADA
      AND CAST(GETDATE() AS date) >          DATEADD(DAY,
              CASE
                  WHEN A.nom_forma_pagamento LIKE \\'%FICHA%\\' THEN 11--- PRAZO CORRETO 9 - EM VALIDACAO DEIXAR 11
                  WHEN A.nom_forma_pagamento LIKE \\'%DEBITO%\\' 
                    OR A.nom_forma_pagamento LIKE \\'%D\(C9)BITO%\\' 
                    OR A.nom_forma_pagamento LIKE \\'%Combo%\\' THEN 9 --- PRAZO CORRETO 7 - EM VALIDACAO DEIXAR 9
                  ELSE 0
              END,
              CONVERT(date,
                  CASE 
                      WHEN A.NOM_SEGMENTO = \\'VIDA\\' THEN P.DATA_VENCIMENTO
                      ELSE A.dth_vencimento
                  END
              )
          )
      -- ? VIDA tem que existir na TB_PARCELA_PAG
      AND (
            A.NOM_SEGMENTO <> \\'VIDA\\'
            OR P.NUM_CERTIFICADO IS NOT NULL
          )
)
, Blocos AS (
    SELECT
        NUM_CERTIFICADO,
        NUM_PARCELA,
        rn,
        NUM_PARCELA - rn AS bloco_id
    FROM Parcelas
)
, ParcelasSequenciais AS (
    SELECT
        NUM_CERTIFICADO, 
        NUM_PARCELA,
        bloco_id,
        COUNT(*) OVER (PARTITION BY NUM_CERTIFICADO, bloco_id) AS tamanho_bloco
    FROM Blocos
)
, ParcelasValidas AS (
    SELECT
        NUM_CERTIFICADO,
        NUM_PARCELA,
        bloco_id,
        tamanho_bloco
    FROM ParcelasSequenciais
    WHERE tamanho_bloco >= 1
)
SELECT DISTINCT
    A.NOM_SEGMENTO AS segmento,
    B.COD_AGENCIA AS codAgencia,
    A.NUM_CERTIFICADO AS numeroContrato,
    A.NUM_PARCELA as NumeroParcela,
    ISNULL(B.VLR_ATUAL_CONTRIBUICAO, A.VLR_PREMIO_PARCELA) AS valorProposta,
    -- ? CAMPO ORIGINAL PRESERVADO (somente fonte alterada)
    CONVERT(DATE,
        CASE
            WHEN A.NOM_SEGMENTO = \\'VIDA\\' THEN P.DATA_VENCIMENTO
            ELSE A.dth_vencimento
        END
    ) AS DataVencimentoParcela,
    CASE
      WHEN A.nom_forma_pagamento LIKE \\'%DEBITO%\\' THEN \\'Debito em Conta\\'
      WHEN A.nom_forma_pagamento LIKE \\'%D\(C9)BITO%\\' THEN \\'Debito em Conta\\'
      WHEN A.nom_forma_pagamento LIKE \\'%FICHA%\\' THEN \\'Boleto\\'
      WHEN A.nom_forma_pagamento LIKE \\'%Combo%\\' THEN \\'Debito em Conta\\'
      ELSE A.nom_forma_pagamento
    END AS formaPagamento,
    B.IND_PERIODICIDADE_COBRANCA AS opcaoPagamento,
    A.COD_AGENCIA AS AgenciaCob,
    A.cod_Operacao AS CodOperacaoCob,
    A.num_Conta AS NumContaCob,
    A.cod_idlg AS Idlg,
    \\'\\' AS NumeroCartaoCredito,
    D.NOM_LOGRADOURO AS logradouro,
    D.NUM_LOGRADOURO AS Numlogradouro,
    D.DES_COMPL_ENDERECO AS ComplEndereco,
    D.NOM_BAIRRO AS Bairro,
    D.NOM_CIDADE AS Cidade,
    D.COD_UF AS Uf,
    D.NOM_PESSOA,
    D.NUM_CPF_CNPJ AS codCpfCnpj,
    E.DES_PRODUTO AS nomeProduto,
    A.ULT_COBRANCA AS dataHoraUltimaCob,
    CASE
      WHEN A.NOM_SEGMENTO = \\'PREVIDENCIA\\' THEN FLOOR(DATEDIFF(MONTH, B.DTA_INICIO_VIGENCIA, GETDATE()))
      WHEN A.NOM_SEGMENTO = \\'VIDA\\' THEN FLOOR(DATEDIFF(MONTH, B.DTA_QUITACAO, GETDATE()))
      ELSE NULL
    END AS TempoContrato,
    E.IND_CONJUGADO AS Comunicabilidade,
    CASE
      WHEN ben.NOM_PESSOA IN (\\'HERDEIROS LEGAIS\\') THEN \\'N\(E3)o\\'
      WHEN ben.NOM_PESSOA IS NULL THEN \\'N\(E3)o\\'
      ELSE \\'Sim\\'
    END as benficiariosExistentes
FROM dbo.DM_COBRANCA_CVP A
INNER JOIN DM_CONTRATOS_CVP B
    ON A.NUM_CERTIFICADO = B.NUM_CERTIFICADO
INNER JOIN (
    SELECT *
    FROM (
        SELECT 
            *,
            ROW_NUMBER() OVER (
                PARTITION BY NUM_CERTIFICADO 
                ORDER BY 
                    CASE 
                        WHEN NOM_LOGRADOURO IS NOT NULL AND NOM_LOGRADOURO <> \\'N\(C3)O SE APLICA\\' THEN 1
                        ELSE 2
                    END,
                    NOM_PESSOA
            ) AS rn
        FROM DM_CLIENTES_CONTRATOS_CVP
\(9)WHERE 1=1 
\(9)\(9)AND COD_PESSOA = 1
    ) X
    WHERE rn = 1
) D
ON B.NUM_CERTIFICADO = D.NUM_CERTIFICADO
INNER JOIN DM_CLIENTES_UNIFICADOS_CVP F
    ON D.NUM_CPF_CNPJ = F.NUM_CPF_CNPJ
LEFT JOIN VW_PRODUTOS_CVP E
    ON B.COD_PRODUTO_COMPLETO = E.COD_PRODUTO_COMPLETO
LEFT JOIN DM_BENEFICIARIOS_CONTRATOS_CVP ben
    ON ben.NUM_CERTIFICADO = A.NUM_CERTIFICADO
   AND ben.NOM_SEGMENTO = A.NOM_SEGMENTO
-- ? JOIN VIDA
LEFT JOIN dbo.TB_PARCELA_PAG P
    ON A.NOM_SEGMENTO = \\'VIDA\\'
   AND P.NUM_CERTIFICADO = A.NUM_CERTIFICADO
   AND P.NUM_PARCELA     = A.NUM_PARCELA
INNER JOIN ParcelasValidas PS
    ON A.NUM_CERTIFICADO = PS.NUM_CERTIFICADO
   AND A.NUM_PARCELA = PS.NUM_PARCELA
WHERE 
    A.NOM_SEGMENTO IN (\\'VIDA\\', \\'PREVIDENCIA\\')
    -- ? REGRA D+7 / D+9
    AND CAST(GETDATE() AS date) >        DATEADD(DAY,
            CASE
                  WHEN A.nom_forma_pagamento LIKE \\'%FICHA%\\' THEN 11--- PRAZO CORRETO 9 - EM VALIDACAO DEIXAR 11
                  WHEN A.nom_forma_pagamento LIKE \\'%DEBITO%\\' 
                    OR A.nom_forma_pagamento LIKE \\'%D\(C9)BITO%\\' 
                    OR A.nom_forma_pagamento LIKE \\'%Combo%\\' THEN 9 --- PRAZO CORRETO 7 - EM VALIDACAO DEIXAR 9
                ELSE 0
            END,
            CONVERT(date,
                CASE
                    WHEN A.NOM_SEGMENTO = \\'VIDA\\' THEN P.DATA_VENCIMENTO
                    ELSE A.dth_vencimento
                END
            )
        )
    -- ? REGRA VIDA
    AND (
          A.NOM_SEGMENTO <> \\'VIDA\\'
          OR P.NUM_CERTIFICADO IS NOT NULL
        )]]><ReadStatementFromFile type=\\'bool\\'><![CDATA[0]]></ReadStatementFromFile><Tables collapsed=\\'1\\'></Tables><Parameters collapsed=\\'1\\'></Parameters><Columns collapsed=\\'1\\'></Columns></SelectStatement><EnablePartitioning collapsed=\\'1\\' type=\\'bool\\'><![CDATA[0]]></EnablePartitioning></SQL><Transaction><RecordCount modified=\\'1\\' type=\\'int\\'><![CDATA[4000]]></RecordCount><EndOfWave collapsed=\\'1\\' type=\\'int\\'><![CDATA[0]]></EndOfWave></Transaction><Session><IsolationLevel type=\\'int\\'><![CDATA[1]]></IsolationLevel><AutocommitMode type=\\'int\\'><![CDATA[0]]></AutocommitMode><ArraySize modified=\\'1\\' type=\\'int\\'><![CDATA[4000]]></ArraySize><SchemaReconciliation><FailOnSizeMismatch modified=\\'1\\' type=\\'bool\\'><![CDATA[0]]></FailOnSizeMismatch><FailOnTypeMismatch modified=\\'1\\' type=\\'bool\\'><![CDATA[0]]></FailOnTypeMismatch><FailOnCodePageMismatch type=\\'bool\\'><![CDATA[0]]></FailOnCodePageMismatch></SchemaReconciliation><PassLobLocator collapsed=\\'1\\' type=\\'bool\\'><![CDATA[0]]></PassLobLocator><CodePage collapsed=\\'1\\' type=\\'int\\'><![CDATA[0]]></CodePage></Session><BeforeAfter collapsed=\\'1\\' type=\\'bool\\'><![CDATA[0]]></BeforeAfter><LimitRows collapsed=\\'1\\' type=\\'bool\\'><![CDATA[0]]></LimitRows></Usage></Properties >'
-connector '{
   variant=\\'3.5\\', 
   library=ccodbc, 
   version=1.0, 
   variantlist=\\'V1;3.5::ccodbc\\', 
   versionlist=\\'1.0\\', 
   name=ODBCConnector
}'
-source 0 '{
      DSSQLType={segmento=12, codAgencia=4, numeroContrato=3, NumeroParcela=4, valorProposta=3, DataVencimentoParcela=9, formaPagamento=12, opcaoPagamento=1, AgenciaCob=4, CodOperacaoCob=4, NumContaCob=12, Idlg=12, NumeroCartaoCredito=12, logradouro=12, Numlogradouro=12, ComplEndereco=12, Bairro=12, Cidade=12, Uf=1, NOM_PESSOA=12, codCpfCnpj=-5, nomeProduto=12, dataHoraUltimaCob=11, TempoContrato=4, Comunicabilidade=1, benficiariosExistentes=12}, 
      DSSQLPrecision={segmento=20, numeroContrato=19, valorProposta=18, formaPagamento=200, opcaoPagamento=2, NumContaCob=22, Idlg=40, NumeroCartaoCredito=1, logradouro=200, Numlogradouro=200, ComplEndereco=200, Bairro=200, Cidade=200, Uf=2, NOM_PESSOA=200, nomeProduto=100, Comunicabilidade=5, benficiariosExistentes=5}, 
      DSSQLScale={valorProposta=2}, 
      DSSchema=\\'record
         (
           segmento\\:nullable string\\[max\\=20\\]\\;
           codAgencia\\:nullable int32\\;
           numeroContrato\\:nullable decimal\\[19\\,0\\]\\;
           NumeroParcela\\:nullable int32\\;
           valorProposta\\:nullable decimal\\[18\\,2\\]\\;
           DataVencimentoParcela\\:nullable date\\;
           formaPagamento\\:nullable string\\[max\\=200\\]\\;
           opcaoPagamento\\:nullable string\\[2\\]\\;
           AgenciaCob\\:nullable int32\\;
           CodOperacaoCob\\:nullable int32\\;
           NumContaCob\\:nullable string\\[max\\=22\\]\\;
           Idlg\\:nullable string\\[max\\=40\\]\\;
           NumeroCartaoCredito\\:nullable string\\[max\\=1\\]\\;
           logradouro\\:nullable string\\[max\\=200\\]\\;
           Numlogradouro\\:nullable string\\[max\\=200\\]\\;
           ComplEndereco\\:nullable string\\[max\\=200\\]\\;
           Bairro\\:nullable string\\[max\\=200\\]\\;
           Cidade\\:nullable string\\[max\\=200\\]\\;
           Uf\\:nullable string\\[2\\]\\;
           NOM_PESSOA\\:nullable string\\[max\\=200\\]\\;
           codCpfCnpj\\:nullable int64\\;
           nomeProduto\\:nullable string\\[max\\=100\\]\\;
           dataHoraUltimaCob\\:nullable timestamp\\;
           TempoContrato\\:nullable int32\\;
           Comunicabilidade\\:nullable string\\[5\\]\\;
           benficiariosExistentes\\:nullable string\\[max\\=5\\]\\;
         )\\'
}'
   
## General options
[ident('EXT_PARCELAS_CLIENTES'); jobmon_ident('EXT_PARCELAS_CLIENTES')]
## Outputs
0> [modify (
  segmento:nullable string[max=20]=segmento;
  codAgencia:nullable int32=codAgencia;
  numeroContrato:nullable decimal[19,0]=numeroContrato;
  NumeroParcela:nullable int32=NumeroParcela;
  valorProposta:nullable decimal[18,2]=valorProposta;
  DataVencimentoParcela:nullable date=DataVencimentoParcela;
  formaPagamento:nullable string[max=200]=formaPagamento;
  opcaoPagamento:nullable string[2]=opcaoPagamento;
  AgenciaCob:nullable int32=AgenciaCob;
  CodOperacaoCob:nullable int32=CodOperacaoCob;
  NumContaCob:nullable string[max=22]=NumContaCob;
  Idlg:nullable string[max=40]=Idlg;
  NumeroCartaoCredito:nullable string[max=1]=NumeroCartaoCredito;
  logradouro:nullable string[max=200]=logradouro;
  Numlogradouro:nullable string[max=200]=Numlogradouro;
  ComplEndereco:nullable string[max=200]=ComplEndereco;
  Bairro:nullable string[max=200]=Bairro;
  Cidade:nullable string[max=200]=Cidade;
  Uf:nullable string[2]=Uf;
  NOM_PESSOA:nullable string[max=200]=NOM_PESSOA;
  codCpfCnpj:nullable int64=codCpfCnpj;
  nomeProduto:nullable string[max=100]=nomeProduto;
  dataHoraUltimaCob:nullable timestamp=dataHoraUltimaCob;
  TempoContrato:nullable int32=TempoContrato;
  Comunicabilidade:nullable string[5]=Comunicabilidade;
  benficiariosExistentes:nullable string[max=5]=benficiariosExistentes;
keep
  segmento,codAgencia,numeroContrato,NumeroParcela,
  valorProposta,DataVencimentoParcela,formaPagamento,opcaoPagamento,
  AgenciaCob,CodOperacaoCob,NumContaCob,Idlg,
  NumeroCartaoCredito,logradouro,Numlogradouro,ComplEndereco,
  Bairro,Cidade,Uf,NOM_PESSOA,
  codCpfCnpj,nomeProduto,dataHoraUltimaCob,TempoContrato,
  Comunicabilidade,benficiariosExistentes;
)] 'EXT_PARCELAS_CLIENTES:LnkParcelasPagas.v'
;
