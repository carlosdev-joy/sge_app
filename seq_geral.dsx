#################################################################
#### STAGE: EXT_PARCELAS_PAGAS
## Operator
pxbridge
## Operator options
-Orientation link
-XMLProperties '<?xml version=\\'1.0\\' encoding=\\'UTF-16\\'?><Properties version=\\'1.1\\'><Common><Context type=\\'int\\'>1</Context><Variant type=\\'string\\'>3.5</Variant><DescriptorVersion type=\\'string\\'>1.0</DescriptorVersion><PartitionType type=\\'int\\'>-1</PartitionType><RCP type=\\'int\\'>0</RCP></Common><Connection><DataSource modified=\\'1\\' type=\\'string\\'><![CDATA[[&"SSD_DIROT.ParmDbNameTDDB05"]]]></DataSource><Username modified=\\'1\\' type=\\'string\\'><![CDATA[[&"SSD_DIROT.ParmDbUserTDDB05"]]]></Username><Password modified=\\'1\\' type=\\'string\\'><![CDATA[[&"SSD_DIROT.ParmDbPwdTDDB05"]]]></Password></Connection><Usage><GenerateSQL type=\\'bool\\'><![CDATA[0]]></GenerateSQL><EnableQuotedIDs type=\\'bool\\'><![CDATA[0]]></EnableQuotedIDs><SQL><SelectStatement modified=\\'1\\' type=\\'string\\'><![CDATA[SELECT 
    T1.NUM_CERTIFICADO,
    T1.NUM_PARCELA,
    T1.SIT_REGISTRO,
     T1.DATA_VENCIMENTO
FROM 
    COBER_HIST_VIDAZUL T1
WHERE 
    T1.SIT_REGISTRO = \\' \\'
    AND T1.DATA_VENCIMENTO >= DATEADD(MONTH, -4, CAST(GETDATE() AS DATE))
ORDER BY 
