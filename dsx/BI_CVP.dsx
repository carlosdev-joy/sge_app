#################################################################
#### STAGE: Lookup_23
## Operator
pxbridge
## Operator options
-Orientation link
-XMLProperties '<?xml version=\\'1.0\\' encoding=\\'UTF-16\\'?><Properties version=\\'1.1\\'><Common><Context type=\\'int\\'>3</Context><Variant type=\\'string\\'>3.5</Variant><DescriptorVersion type=\\'string\\'>1.0</DescriptorVersion><PartitionType type=\\'int\\'>-1</PartitionType><RCP type=\\'int\\'>0</RCP></Common><Connection><DataSource modified=\\'1\\' type=\\'string\\'><![CDATA[[&\"SSD_DIROT.ParmDbNameTDDB05\"]]]></DataSource><Username modified=\\'1\\' type=\\'string\\'><![CDATA[[&\"SSD_DIROT.ParmDbUserTDDB05\"]]]></Username><Password modified=\\'1\\' type=\\'string\\'><![CDATA[[&\"SSD_DIROT.ParmDbPwdTDDB05\"]]]></Password></Connection><Usage><GenerateSQL type=\\'bool\\'><![CDATA[0]]></GenerateSQL><EnableQuotedIDs type=\\'bool\\'><![CDATA[0]]></EnableQuotedIDs><SQL><SelectStatement modified=\\'1\\' type=\\'string\\'><![CDATA[-- Consulta Vida - Cobertura
----------------------------------------------------------
SELECT
Cast(T1.NUM_CERTIFICADO as BigInt) as NUM_CERTIFICADO,
\\'VIDA\\' as NOM_SEGMENTO,
cast(0 as Varchar) AS  codCobertura,
cast(concat (PROD.cod_subgrupo,PROD.RAMO) as BigInt) AS codRamoCobertura,
Cast(NULL as Varchar) as descCobertura,
Cast(NULL as Varchar) as descFranquia
,Cast(T2.IMPSEGUR as decimal) AS valorCoberturaBruto
,Cast(FIDELIZ1.VAL_IOF as decimal) AS  valorCoberturaIOF
,Cast(T2.IMPSEGUR as decimal) AS valorImpSegurada
  FROM PROPOSTAS_VA T1
         JOIN HIS_COBER_PROPOST T2 ON T2.NUM_CERTIFICADO = T1.NUM_CERTIFICADO 
           AND T2.OCORR_HISTORICO = (SELECT MIN (OCORR_HISTORICO) FROM HIS_COBER_PROPOST where NUM_CERTIFICADO = T1.NUM_CERTIFICADO)
        JOIN VG_APOLICE_COB_GAR A ON A.NUM_APOLICE = T1.NUM_APOLICE 
         AND A.COD_SUBGRUPO = T1.COD_SUBGRUPO 
         AND A.COD_PRODUTO = T1.COD_PRODUTO 
         AND A.IND_TIPO_COB_GAR in (\\'PF\\',\\'CC\\') AND A.IND_PERIODO_FAT = 0
         JOIN VG_GRUPO_COB_CS_ETARIA B ON A.SEQ_GRUPO_COBERTURA = B.SEQ_GRUPO_COBERTURA AND A.NUM_GARANTIA = B.NUM_GARANTIA AND A.DTA_INI_VIGENCIA = B.DTA_INI_VIGENCIA
        JOIN VG_FAIXA_ETARIA C ON B.SEQ_FAIXA_ETARIA = C.SEQ_FAIXA_ETARIA AND C.NUM_FAIXA_INICIAL <= T1.IDADE AND C.NUM_FAIXA_FINAL >= T1.IDADE
       JOIN VG_FAIXA_CAP_SEGUR D ON B.SEQ_FAIXA_CAP_SEGUR = D.SEQ_FAIXA_CAP_SEGUR AND D.VLR_FAIXA_CS_INICIAL <= T2.IMPSEGUR AND D.VLR_FAIXA_CS_FINAL >= T2.IMPSEGUR
       LEFT JOIN VG_GARANTIA E ON A.NUM_GARANTIA = E.NUM_GARANTIA
       LEFT JOIN VG_GRUPO_COBERTURA F ON A.SEQ_GRUPO_COBERTURA = F.SEQ_GRUPO_COBERTURA
       LEFT JOIN PRODUTOS_VG PROD WITH(NOLOCK) ON PROD.NUM_APOLICE = T1.NUM_APOLICE AND PROD.COD_SUBGRUPO = T1.COD_SUBGRUPO
\(9)   LEFT JOIN PRODUTO PDT WITH(NOLOCK) ON PDT.COD_PRODUTO = PROD.COD_PRODUTO AND PDT.RAMO_EMISSOR = PROD.RAMO
\(9)   LEFT JOIN  SUBGRUPOS_VGAP SUB    WITH(NOLOCK) ON T1.NUM_APOLICE = SUB.NUM_APOLICE AND T1.COD_SUBGRUPO = SUB.COD_SUBGRUPO
\(9)   LEFT OUTER JOIN PROPOSTA_FIDELIZ FIDELIZ1      WITH(NOLOCK) ON FIDELIZ1.NUM_PROPOSTA_SIVPF = T1.NUM_CERTIFICADO and FIDELIZ1.IBMSNAP_OPERATION <> \\'D\\'
\(9)   LEFT JOIN ( 
\(9)SELECT             
    T1.NUM_CERTIFICADO,            
    DATA_EMISSAO = T2.DATA_OPERACAO,
\(9)T2.COD_OPERACAO
FROM  SEGURADOS_VGAP T1 WITH(NOLOCK)
LEFT JOIN SEGURADOSVGAP_HIST T2 WITH(NOLOCK) ON T2.NUM_APOLICE = T1.NUM_APOLICE AND T2.NUM_ITEM = T1.NUM_ITEM AND T2.COD_OPERACAO BETWEEN 100 AND 299 AND T2.COD_OPERACAO NOT IN (202)
) AS SQ3    ON T1.NUM_CERTIFICADO = SQ3.NUM_CERTIFICADO
 -- LEFT JOIN VG_CARENCIA_MSG  G ON A.SEQ_CARENCIA = G.SEQ_CARENCIA_MSG
--where dtinclus  < orchestrate.maxdat
--where T1.NUM_CERTIFICADO = 10000235886]]><ReadStatementFromFile type=\\'bool\\'><![CDATA[0]]></ReadStatementFromFile><Tables collapsed=\\'1\\'></Tables><Parameters collapsed=\\'1\\'></Parameters><Columns collapsed=\\'1\\'></Columns></SelectStatement></SQL><Transaction><RecordCount modified=\\'1\\' type=\\'int\\'><![CDATA[4000]]></RecordCount><EndOfWave collapsed=\\'1\\' type=\\'int\\'><![CDATA[0]]></EndOfWave></Transaction><Session><IsolationLevel type=\\'int\\'><![CDATA[1]]></IsolationLevel><AutocommitMode type=\\'int\\'><![CDATA[0]]></AutocommitMode><ArraySize modified=\\'1\\' type=\\'int\\'><![CDATA[4000]]></ArraySize><SchemaReconciliation><FailOnSizeMismatch type=\\'bool\\'><![CDATA[1]]></FailOnSizeMismatch><FailOnTypeMismatch type=\\'bool\\'><![CDATA[1]]></FailOnTypeMismatch><FailOnCodePageMismatch type=\\'bool\\'><![CDATA[0]]></FailOnCodePageMismatch></SchemaReconciliation><PassLobLocator collapsed=\\'1\\' type=\\'bool\\'><![CDATA[0]]></PassLobLocator><CodePage collapsed=\\'1\\' type=\\'int\\'><![CDATA[0]]></CodePage></Session><BeforeAfter collapsed=\\'1\\' type=\\'bool\\'><![CDATA[0]]></BeforeAfter></Usage></Properties >'
-connector '{
   variant=\\'3.5\\', 
   library=ccodbc, 
   version=1.0, 
   variantlist=\\'V1;3.5::ccodbc\\', 
   versionlist=\\'1.0\\', 
   name=ODBCConnector
}'
-source 0 '{
      DSSQLType={NUM_CERTIFICADO=-5, codCobertura=12, codRamoCobertura=-5, descCobertura=12, descFranquia=12, valorCoberturaBruto=3, valorCoberturaIOF=3, valorImpSegurada=3, NOM_SEGMENTO=12}, 
      DSSQLPrecision={codCobertura=50, codRamoCobertura=100, descCobertura=200, descFranquia=50, valorCoberturaBruto=28, valorCoberturaIOF=28, valorImpSegurada=28, NOM_SEGMENTO=40}, 
      DSSQLScale={valorCoberturaBruto=2, valorCoberturaIOF=2, valorImpSegurada=2}, 
      DSSchema=\\'record
         (
           NUM_CERTIFICADO\\:nullable int64\\;
           codCobertura\\:nullable string\\[max\\=50\\]\\;
           codRamoCobertura\\:nullable int64\\;
           descCobertura\\:nullable string\\[max\\=200\\]\\;
           descFranquia\\:nullable string\\[max\\=50\\]\\;
           valorCoberturaBruto\\:nullable decimal\\[28\\,2\\]\\;
           valorCoberturaIOF\\:nullable decimal\\[28\\,2\\]\\;
           valorImpSegurada\\:nullable decimal\\[28\\,2\\]\\;
           NOM_SEGMENTO\\:string\\[max\\=40\\]\\;
         )\\'
}'
   
-target 0 '{
      DSSQLType={NUM_CERTIFICADO=-5, codCobertura=12, codRamoCobertura=-5, descCobertura=12, descFranquia=12, valorCoberturaBruto=3, valorCoberturaIOF=3, valorImpSegurada=3, NOM_SEGMENTO=12}, 
      DSSQLPrecision={codCobertura=50, codRamoCobertura=100, descCobertura=200, descFranquia=50, valorCoberturaBruto=28, valorCoberturaIOF=28, valorImpSegurada=28, NOM_SEGMENTO=40}, 
      DSSQLScale={valorCoberturaBruto=2, valorCoberturaIOF=2, valorImpSegurada=2}, 
      DSSchema=\\'record
         (
           NUM_CERTIFICADO\\:nullable int64\\;
           codCobertura\\:nullable string\\[max\\=50\\]\\;
           codRamoCobertura\\:nullable int64\\;
           descCobertura\\:nullable string\\[max\\=200\\]\\;
           descFranquia\\:nullable string\\[max\\=50\\]\\;
           valorCoberturaBruto\\:nullable decimal\\[28\\,2\\]\\;
           valorCoberturaIOF\\:nullable decimal\\[28\\,2\\]\\;
           valorImpSegurada\\:nullable decimal\\[28\\,2\\]\\;
           NOM_SEGMENTO\\:string\\[max\\=40\\]\\;
         )\\'
}'
   
-ifNotFound drop
## General options
[ident('Lookup_23'); jobmon_ident('Lookup_23')]
## Inputs
