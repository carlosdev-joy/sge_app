<?xml version='1.0' encoding='UTF-16'?><Properties version='1.1'><Common><Context type='int'>1</Context><Variant type='string'>3.5</Variant><DescriptorVersion type='string'>1.0</DescriptorVersion><PartitionType type='int'>-1</PartitionType><RCP type='int'>0</RCP></Common><Connection><DataSource modified='1' type='string'><![CDATA[#SSD_DIROT.ParmDbNameDMDB42#]]></DataSource><Username modified='1' type='string'><![CDATA[#SSD_DIROT.ParmDbUserDMDB42#]]></Username><Password modified='1' type='string'><![CDATA[#SSD_DIROT.ParmDbPassDMDB42#]]></Password></Connection><Usage><GenerateSQL type='bool'><![CDATA[0]]></GenerateSQL><EnableQuotedIDs type='bool'><![CDATA[0]]></EnableQuotedIDs><SQL><SelectStatement modified='1' type='string'><![CDATA[
-- Consulta Prestamista - Coberturas
----------------------------------------------------------
select 
\(9)Cast(NUM_CONTRATO_SEGURO as BigInt) as NUM_CERTIFICADO,
\(9)Cast(p.COD_COBERTURA as Varchar(50)) as codCobertura,
\(9)Cast(NULL as BigInt) as codRamoCobertura,
\(9)Cast(NULL as Varchar) as descCobertura,
\(9)Cast( NULL as Varchar) as descFranquia,
              'PRESTAMISTA' as NOM_SEGMENTO,
\(9)--p.COD_PRODUTO
\(9)cast( C.VLR_CAP_SEGURADO as decimal) as valorCoberturaBruto,
      cast (C.VLR_IOF_MAX_PREMIO as decimal) as valorCoberturaIOF,
     cast( C.VLR_IS_MAX_PREMIO as decimal) as valorImpSegurada
from DM_ODS_PRS_CONTRATOS_U as C
        left join DM_DIM_PRODUTO as P
            on C.COD_PRODUTO = P.COD_PRODUTO
where STA_CONTRATO = 'A'
        and C.COD_PRODUTO in (7771,
\(9)\(9)\(9)\(9)\(9)\(9)\(9)7761,
\(9)\(9)\(9)\(9)\(9)\(9)\(9)7762,
\(9)\(9)\(9)\(9)\(9)\(9)\(9)7763,
\(9)\(9)\(9)\(9)\(9)\(9)\(9)7770,
\(9)\(9)\(9)\(9)\(9)\(9)\(9)9821,
\(9)\(9)\(9)\(9)\(9)\(9)\(9)7769,
\(9)\(9)\(9)\(9)\(9)\(9)\(9)3727,
\(9)\(9)\(9)\(9)\(9)\(9)\(9)3728,
\(9)\(9)\(9)\(9)\(9)\(9)\(9)7765,
\(9)\(9)\(9)\(9)\(9)\(9)\(9)7766,
\(9)\(9)\(9)\(9)\(9)\(9)\(9)7742,
\(9)\(9)\(9)\(9)\(9)\(9)\(9)7743,
\(9)\(9)\(9)\(9)\(9)\(9)\(9)7741,
\(9)\(9)\(9)\(9)\(9)\(9)\(9)7745,
\(9)\(9)\(9)\(9)\(9)\(9)\(9)7746,
\(9)\(9)\(9)\(9)\(9)\(9)\(9)9811,
\(9)\(9)\(9)\(9)\(9)\(9)\(9)3726
\(9)\(9)\(9)\(9)\(9)\(9)\(9))
and cast(C.DTH_CARGA_ATUALIZACAO as date) <= (SELECT MAX(DataCarga ) as maxdat FROM DMDB41.DBO.BI_CONTROLE_CARGA WHERE Processo = 'CoberturasUnificadas' )]]><ReadStatementFromFile type='bool'><![CDATA[0]]></ReadStatementFromFile><Tables collapsed='1'></Tables><Parameters collapsed='1'></Parameters><Columns collapsed='1'></Columns></SelectStatement><EnablePartitioning collapsed='1' type='bool'><![CDATA[0]]></EnablePartitioning></SQL><Transaction><RecordCount modified='1' type='int'><![CDATA[4000]]></RecordCount><EndOfWave collapsed='1' type='int'><![CDATA[0]]></EndOfWave></Transaction><Session><IsolationLevel type='int'><![CDATA[1]]></IsolationLevel><AutocommitMode type='int'><![CDATA[0]]></AutocommitMode><ArraySize modified='1' type='int'><![CDATA[4000]]></ArraySize><SchemaReconciliation><FailOnSizeMismatch type='bool'><![CDATA[1]]></FailOnSizeMismatch><FailOnTypeMismatch type='bool'><![CDATA[1]]></FailOnTypeMismatch><FailOnCodePageMismatch type='bool'><![CDATA[0]]></FailOnCodePageMismatch></SchemaReconciliation><PassLobLocator collapsed='1' type='bool'><![CDATA[0]]></PassLobLocator><CodePage collapsed='1' type='int'><![CDATA[0]]></CodePage></Session><BeforeAfter collapsed='1' type='bool'><![CDATA[0]]></BeforeAfter><LimitRows collapsed='1' type='bool'><![CDATA[0]]></LimitRows></Usage></Properties >
=+=+=+=
      END DSSUBRECORD
      NextRecordID "0"
   END DSRECORD
