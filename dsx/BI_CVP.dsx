      F14 "3.5\Vccodbc\V1.0\VV1;3.5::ccodbc\Vccodbc\V1.0\Vlink\V-1\V0\V0\Vfalse\VODBCConnector\VEE\Vsource\V/Connection/DataSource\V/Connection/Username\V/Connection/Password\V<?xml version='1.0' encoding='UTF-16'?><Properties version='1.1'><Common><Context type='int'>1</Context><Variant type='string'>3.5</Variant><DescriptorVersion type='string'>1.0</DescriptorVersion><PartitionType type='int'>-1</PartitionType><RCP type='int'>0</RCP></Common><Connection><DataSource modified='1' type='string'><![CDATA[#SSD_DIROT.ParmDbNameDMDB11#]]></DataSource><Username modified='1' type='string'><![CDATA[#SSD_DIROT.ParmDbUserDMDB11#]]></Username><Password modified='1' type='string'><![CDATA[#SSD_DIROT.ParmDbPwdDMDB11#]]></Password></Connection><Usage><GenerateSQL type='bool'><![CDATA[0]]></GenerateSQL><EnableQuotedIDs type='bool'><![CDATA[0]]></EnableQuotedIDs><SQL><SelectStatement modified='1' type='string'><![CDATA[-- Consulta Prev - Coberturas\(D)\(A)----------------------------------------------------------\(D)\(A)SELECT\(D)\(A)cast(bc.NUM_CERTIFICADO as BigInt) as NUM_CERTIFICADO ,\(D)\(A)\(D)\(A)cast(bc.COD_BENEFICIO as Varchar(50)) as codCobertura,\(D)\(A)'PREVIDENCIA' as NOM_SEGMENTO,\(D)\(A)cast('' as BigInt) as codRamoCobertura,\(D)\(A)\(D)\(A)cast(bc.NOME_BENEFICIO as Varchar (200)) as descCobertura,\(D)\(A)\(D)\(A)cast(NUll as Varchar) as descFranquia,\(D)\(A)\(D)\(A)cast(NUll as decimal) as  valorCoberturaBruto,\(D)\(A)\(D)\(A)cast(NUll as decimal) as valorCoberturaIOF,\(D)\(A)\(D)\(A)cast(BC.MON_BENEFICIO as decimal) as valorImpSegurada\(D)\(A)\(D)\(A)FROM [dbo].[SB_T_202101_BENEFICIO_CERTIFICADO] bc\(D)\(A)]]><ReadStatementFromFile type='bool'><![CDATA[0]]></ReadStatementFromFile><Tables collapsed='1'></Tables><Parameters collapsed='1'></Parameters><Columns collapsed='1'></Columns></SelectStatement><EnablePartitioning collapsed='1' type='bool'><![CDATA[0]]></EnablePartitioning></SQL><Transaction collapsed='1'><RecordCount modified='1' type='int'><![CDATA[4000]]></R