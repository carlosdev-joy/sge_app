----------------------------------------------------------
SELECT
cast(bc.NUM_CERTIFICADO as BigInt) as NUM_CERTIFICADO ,

cast(bc.COD_BENEFICIO as Varchar(50)) as codCobertura,
'PREVIDENCIA' as NOM_SEGMENTO,
cast('' as BigInt) as codRamoCobertura,

cast(bc.NOME_BENEFICIO as Varchar (200)) as descCobertura,

cast(NUll as Varchar) as descFranquia,

cast(NUll as decimal) as  valorCoberturaBruto,

cast(NUll as decimal) as valorCoberturaIOF,

cast(BC.MON_BENEFICIO as decimal) as valorImpSegurada

FROM [dbo].[SB_T_202101_BENEFICIO_CERTIFICADO] bc
