   BEGIN DSRECORD
      Identifier "CopyOfBiCVP_CoberturasUnificadas_001.CONSULTA_VIDA"
      F1 "STAGE"
      F2 "CUSTOM"
      F3 "11.7///60/C"
      F4 "CopyOfBiCVP_CoberturasUnificadas_001"
      F10 "CopyOfBiCVP_CoberturasUnificadas_001.CONSULTA_VIDA.DSLink9"
      F13 "VariantName\VVariantLibrary\VVariantVersion\VSupportedVariants\VSupportedVariantsLibraries\VSupportedVariantsVersions\VOrientation\VRejectFromLink\VRejectThreshold\VRejectNumber\VRejectUsesPercentage\VConnectorName\VEngine\VContext\VConnectionString\VUsername\VPassword\VXMLProperties"
      F14 "3.5\Vccodbc\V1.0\VV1;3.5::ccodbc\Vccodbc\V1.0\Vlink\V-1\V0\V0\Vfalse\VODBCConnector\VEE\Vrequest\V/Connection/DataSource\V/Connection/Username\V/Connection/Password\V<?xml version='1.0' encoding='UTF-16'?><Properties version='1.1'><Common><Context type='int'>3</Context><Variant type='string'>3.5</Variant><DescriptorVersion type='string'>1.0</DescriptorVersion><PartitionType type='int'>-1</PartitionType><RCP type='int'>0</RCP></Common><Connection><DataSource modified='1' type='string'><![CDATA[#SSD_DIROT.PamDbNameReplicaSIAS#]]></DataSource><Username modified='1' type='string'><![CDATA[#SSD_DIROT.PamDbUserReplicaSIAS#]]></Username><Password modified='1' type='string'><![CDATA[#SSD_DIROT.PamDbPassReplicaSIAS#]]></Password></Connection><Usage><GenerateSQL type='bool'><![CDATA[0]]></GenerateSQL><EnableQuotedIDs type='bool'><![CDATA[0]]></EnableQuotedIDs><SQL><SelectStatement modified='1' type='string'><![CDATA[-- Consulta Vida - Cobertura\(D)\(A)----------------------------------------------------------\(D)\(A)SELECT\(D)\(A)Cast(T1.NUM_CERTIFICADO as BigInt) as NUM_CERTIFICADO,\(D)\(A)'VIDA' as NOM_SEGMENTO,\(D)\(A)cast(0 as Varchar(50)) AS  codCobertura,\(D)\(A)cast(concat (PROD.cod_subgrupo,PROD.RAMO) as BigInt) AS codRamoCobertura,\(D)\(A)Cast(NULL as Varchar (200)) as descCobertura,\(D)\(A)Cast(NULL as Varchar) as descFranquia\(D)\(A),Cast(T2.IMPSEGUR as decimal) AS valorCoberturaBruto\(D)\(A),Cast(FIDELIZ1.VAL_IOF as decimal) AS  valorCoberturaIOF\(D)\(A),Cast(T2.IMPSEGUR as decimal) AS valorImpSegurada\(D)\(A)  FROM PROPOSTAS_VA T1\(D)\(A)         JOIN HIS_COBER_PROPOST T2 ON T2.NUM_CERTIFICADO = T1.NUM_CERTIFICADO \(D)\(A)           AND T2.OCORR_HISTORICO = (SELECT MIN (OCORR_HISTORICO) FROM HIS_COBER_PROPOST where NUM_CERTIFICADO = T1.NUM_CERTIFICADO)\(D)\(A)        JOIN VG_APOLICE_COB_GAR A ON A.NUM_APOLICE = T1.NUM_APOLICE \(D)\(A)         AND A.COD_SUBGRUPO = T1.COD_SUBGRUPO \(D)\(A)         AND A.COD_PRODUTO = T1.COD_PRODUTO \(D)\(A)         AND A.IND_TIPO_COB_GAR in ('PF','CC') AND A.IND_PERIODO_FAT = 0\(D)\(A)         JOIN VG_GRUPO_COB_CS_ETARIA B ON A.SEQ_GRUPO_COBERTURA = B.SEQ_GRUPO_COBERTURA AND A.NUM_GARANTIA = B.NUM_GARANTIA AND A.DTA_INI_VIGENCIA = B.DTA_INI_VIGENCIA\(D)\(A)        JOIN VG_FAIXA_ETARIA C ON B.SEQ_FAIXA_ETARIA = C.SEQ_FAIXA_ETARIA AND C.NUM_FAIXA_INICIAL <= T1.IDADE AND C.NUM_FAIXA_FINAL >= T1.IDADE\(D)\(A)       JOIN VG_FAIXA_CAP_SEGUR D ON B.SEQ_FAIXA_CAP_SEGUR = D.SEQ_FAIXA_CAP_SEGUR AND D.VLR_FAIXA_CS_INICIAL <= T2.IMPSEGUR AND D.VLR_FAIXA_CS_FINAL >= T2.IMPSEGUR\(D)\(A)       LEFT JOIN VG_GARANTIA E ON A.NUM_GARANTIA = E.NUM_GARANTIA\(D)\(A)       LEFT JOIN VG_GRUPO_COBERTURA F ON A.SEQ_GRUPO_COBERTURA = F.SEQ_GRUPO_COBERTURA\(D)\(A)       LEFT JOIN PRODUTOS_VG PROD WITH(NOLOCK) ON PROD.NUM_APOLICE = T1.NUM_APOLICE AND PROD.COD_SUBGRUPO = T1.COD_SUBGRUPO\(D)\(A)\(9)   LEFT JOIN PRODUTO PDT WITH(NOLOCK) ON PDT.COD_PRODUTO = PROD.COD_PRODUTO AND PDT.RAMO_EMISSOR = PROD.RAMO\(D)\(A)\(9)   LEFT JOIN  SUBGRUPOS_VGAP SUB    WITH(NOLOCK) ON T1.NUM_APOLICE = SUB.NUM_APOLICE AND T1.COD_SUBGRUPO = SUB.COD_SUBGRUPO\(D)\(A)\(9)   LEFT OUTER JOIN PROPOSTA_FIDELIZ FIDELIZ1      WITH(NOLOCK) ON FIDELIZ1.NUM_PROPOSTA_SIVPF = T1.NUM_CERTIFICADO and FIDELIZ1.IBMSNAP_OPERATION <> 'D'\(D)\(A)\(9)   LEFT JOIN ( \(D)\(A)\(9)SELECT             \(D)\(A)    T1.NUM_CERTIFICADO,            \(D)\(A)    DATA_EMISSAO = T2.DATA_OPERACAO,\(D)\(A)\(9)T2.COD_OPERACAO\(D)\(A)FROM  SEGURADOS_VGAP T1 WITH(NOLOCK)\(D)\(A)LEFT JOIN SEGURADOSVGAP_HIST T2 WITH(NOLOCK) ON T2.NUM_APOLICE = T1.NUM_APOLICE AND T2.NUM_ITEM = T1.NUM_ITEM AND T2.COD_OPERACAO BETWEEN 100 AND 299 AND T2.COD_OPERACAO NOT IN (202)\(D)\(A)) AS SQ3    ON T1.NUM_CERTIFICADO = SQ3.NUM_CERTIFICADO\(D)\(A) -- LEFT JOIN VG_CARENCIA_MSG  G ON A.SEQ_CARENCIA = G.SEQ_CARENCIA_MSG\(D)\(A)where dtinclus  < orchestrate.maxdat\(D)\(A)--where T1.NUM_CERTIFICADO = 10000235886]]><ReadStatementFromFile type='bool'><![CDATA[0]]></ReadStatementFromFile><Tables collapsed='1'></Tables><Parameters collapsed='1'></Parameters><Columns collapsed='1'></Columns></SelectStatement></SQL><Transaction><RecordCount modified='1' type='int'><![CDATA[4000]]></RecordCount><EndOfWave collapsed='1' type='int'><![CDATA[0]]></EndOfWave></Transaction><Session><IsolationLevel type='int'><![CDATA[1]]></IsolationLevel><AutocommitMode type='int'><![CDATA[0]]></AutocommitMode><ArraySize modified='1' type='int'><![CDATA[4000]]></ArraySize><SchemaReconciliation><FailOnSizeMismatch type='bool'><![CDATA[1]]></FailOnSizeMismatch><FailOnTypeMismatch type='bool'><![CDATA[1]]></FailOnTypeMismatch><FailOnCodePageMismatch type='bool'><![CDATA[0]]></FailOnCodePageMismatch></SchemaReconciliation><PassLobLocator collapsed='1' type='bool'><![CDATA[0]]></PassLobLocator><CodePage collapsed='1' type='int'><![CDATA[0]]></CodePage></Session><BeforeAfter collapsed='1' type='bool'><![CDATA[0]]></BeforeAfter></Usage></Properties >"
