      F14 "3.5\Vccodbc\V1.0\VV1;3.5::ccodbc\Vccodbc\V1.0\Vlink\V-1\V0\V0\Vfalse\VODBCConnector\VEE\Vsource\V/Connection/DataSource\V/Connection/Username\V/Connection/Password\V<?xml version='1.0' encoding='UTF-16'?><Properties version='1.1'><Common><Context type='int'>1</Context><Variant type='string'>3.5</Variant><DescriptorVersion type='string'>1.0</DescriptorVersion><PartitionType type='int'>-1</PartitionType><RCP type='int'>0</RCP></Common><Connection><DataSource modified='1' type='string'><![CDATA[#SSD_DIROT.ParmDbNameTDDB05#]]></DataSource><Username modified='1' type='string'><![CDATA[#SSD_DIROT.ParmDbUserTDDB05#]]></Username><Password modified='1' type='string'><![CDATA[#SSD_DIROT.ParmDbPwdTDDB05#]]></Password></Connection><Usage><GenerateSQL type='bool'><![CDATA[0]]></GenerateSQL><EnableQuotedIDs type='bool'><![CDATA[0]]></EnableQuotedIDs><SQL><SelectStatement modified='1' type='string'><![CDATA[SELECT \(D)\(A)      A.NUM_CERTIFICADO\(D)\(A)\(9) ,'VIDA' as NOM_SEGMENTO\(D)\(A)     , cast(B.COD_COBERTURA as varchar(50)) as codCobertura\(D)\(A)\(9) ,B.RAMO_COBERTURA\(9)as codRamoCobertura\(D)\(A)\(9) ,Cast(NULL as Varchar (200)) as descCobertura\(D)\(A)      ,Cast(NULL as Varchar) as descFranquia\(D)\(A)\(9) ,Cast(null as decimal) AS valorCoberturaBruto\(D)\(A)     ,Cast(null as decimal) AS  valorCoberturaIOF\(D)\(A)     ,Cast(null as decimal) AS valorImpSegurada\(D)\(A)FROM SEGURADOS_VGAP A\(D)\(A)   inner join VG_COBERTURAS_SUBG B\(D)\(A)   on B.NUM_APOLICE = A.NUM_APOLICE \(D)\(A)\(9)inner join CLIENTES C\(D)\(A)\(9)on C.COD_CLIENTE = A.COD_CLIENTE \(D)\(A)   inner join VG_ACESSORIO D\(D)\(A)   on D.NUM_ACESSORIO = B.COD_COBERTURA\(D)\(A)   WHERE \(D)\(A)      A.SIT_REGISTRO = '0'\(D)\(A)\(9)  and D.IND_TIPO_ACESSORIO = 'C']]><ReadStatementFromFile type='bool'><![CDATA[0]]></ReadStatementFromFile><Tables collapsed='1'></Tables><Parameters collapsed='1'></Parameters><Columns collapsed='1'></Columns></SelectStatement><EnablePartitioning collapsed='1' type='bool'><![CDATA[0]]></EnablePartitioning></SQL><Transaction><RecordCount modified='1' type='int'><![CDATA[4000]]></RecordCount><EndOfWave collapsed='1' type='int'><![CDATA[0]]></EndOfWave></Transaction><Session><IsolationLevel type='int'><![CDATA[1]]></IsolationLevel><AutocommitMode type='int'><![CDATA[0]]></AutocommitMode><ArraySize modified='1' type='int'><![CDATA[4000]]></ArraySize><SchemaReconciliation><FailOnSizeMismatch type='bool'><![CDATA[1]]></FailOnSizeMismatch><FailOnTypeMismatch type='bool'><![CDATA[1]]></FailOnTypeMismatch><FailOnCodePageMismatch type='bool'><![CDATA[0]]></FailOnCodePageMismatch></SchemaReconciliation><PassLobLocator collapsed='1' type='bool'><![CDATA[0]]></PassLobLocator><CodePage collapsed='1' type='int'><![CDATA[0]]></CodePage></Session><BeforeAfter collapsed='1' type='bool'><![CDATA[0]]></BeforeAfter><LimitRows collapsed='1' type='bool'><![CDATA[0]]></LimitRows></Usage></Properties >"
