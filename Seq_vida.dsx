   End
   If (seq$V0S224$status = 1) Then
      Call DSLogInfo(DSMakeMsg(\"DSTAGE_JSG_M_0072\\Note: Sequencer '%1' was entered, but never exited\", \"WaitCargaDime\"), \"@Coordinator\")
   End
   If (seq$V0S263$status = 1) Then
      Call DSLogInfo(DSMakeMsg(\"DSTAGE_JSG_M_0072\\Note: Sequencer '%1' was entered, but never exited\", \"WaitFimFatos\"), \"@Coordinator\")
   End
   If (seq$V0S274$status = 1) Then
      Call DSLogInfo(DSMakeMsg(\"DSTAGE_JSG_M_0072\\Note: Sequencer '%1' was entered, but never exited\", \"WaitSinistro\"), \"@Coordinator\")
   End
   If (seq$V0S277$status = 1) Then
      Call DSLogInfo(DSMakeMsg(\"DSTAGE_JSG_M_0072\\Note: Sequencer '%1' was entered, but never exited\", \"WaitFinanceiro\"), \"@Coordinator\")
   End
   If (seq$V0S281$status = 1) Then
      Call DSLogInfo(DSMakeMsg(\"DSTAGE_JSG_M_0072\\Note: Sequencer '%1' was entered, but never exited\", \"WaitFim\"), \"@Coordinator\")
   End
   summary$<1,-1> = Time$$:Convert(@VM, \" \", DSMakeMsg(\"DSTAGE_JSG_M_0054\\Sequence finished OK\", \"\"))
   x$masked$summary = summary$
   Call DSMaskExecArgs(x$masked$summary, '')
   Call DSLogInfo(x$masked$summary, \"@Coordinator\")
   L$EXIT: Return To L$EXIT
 

END

