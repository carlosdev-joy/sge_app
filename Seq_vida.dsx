      Call DSLogWarn(DSMakeMsg(\"DSTAGE_JSG_M_0011\\Error while executing error activity: %1\", \"Exception\"), msg$id)
   End
   b$Abandoning = @True
   GoTo L$WAITFORJOB
L$ABORT:
   summary$<1,-1> = Time$$:Convert(@VM, \" \", DSMakeMsg(\"DSTAGE_JSG_M_0056\\Sequence failed\", \"\"))
   x$masked$summary = summary$
   Call DSMaskExecArgs(x$masked$summary, '')
