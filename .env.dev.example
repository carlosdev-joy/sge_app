# .env.dev — Variáveis do ambiente de DESENVOLVIMENTO
# Copie para .env.dev e preencha. NUNCA commite o .env.dev com dados reais.

# ── Airflow UID ─────────────────────────────────────────────────────────────
# Use 0 se estiver rodando como root na VPS
AIRFLOW_UID=0

# ── Airflow web ──────────────────────────────────────────────────────────────
DEV_AIRFLOW_USER=admin
DEV_AIRFLOW_PASSWORD=admin123

# ── SQL Server de dev (container Docker) ─────────────────────────────────────
# Senha do usuário SA — deve ter: maiúscula, minúscula, número e símbolo
DEV_MSSQL_SA_PASSWORD=Orquestra@Dev2024

# ── Diretório base do projeto ────────────────────────────────────────────────
AIRFLOW_PROJ_DIR=.

# ── Portas expostas ──────────────────────────────────────────────────────────
UI_PORT=8081
AIRFLOW_PORT=8082
API_PORT=8000

# ── ORQUESTRA API ─────────────────────────────────────────────────────────────
# A API lê a connection string PRONTA (não monta das partes abaixo):
MSSQL_CONN_STR=DRIVER={ODBC Driver 18 for SQL Server};SERVER=sqlserver-dev,1433;DATABASE=orquestra_dev;UID=sa;PWD=Orquestra@Dev2024;TrustServerCertificate=yes;
MSSQL_SERVER=orquestra-sqlserver-dev
MSSQL_DATABASE=orquestra_dev
MSSQL_USER=sa
MSSQL_PASSWORD=Orquestra@Dev2024

# ── Credenciais que a API usa para falar com o Airflow ───────────────────────
# (nomes BASE — os DEV_AIRFLOW_* acima valem só para o init do Airflow)
AIRFLOW_WWW_USER_USERNAME=admin
AIRFLOW_WWW_USER_PASSWORD=admin123

# ── Chave Fernet das senhas de dbo.etl_conexao ───────────────────────────────
# Mesma chave nos containers do Airflow e da API. Gerar:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ORQUESTRA_CONN_KEY=

# ── URL do Airflow para os botões "Ver no Airflow" (IP público + porta) ──────
AIRFLOW_UI_URL=http://SEU-IP:8082

# ⚠️ A UI publica na porta de UI_PORT_VIP (default 8090) — o UI_PORT acima não
# é lido pelo compose base. Ver docs/ambiente-dev.md.
