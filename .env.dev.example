# .env.dev — Variáveis do ambiente de DESENVOLVIMENTO
# Copie este arquivo para .env.dev e preencha os valores.
# NUNCA commite o .env.dev com dados reais no repositório.

# ── Airflow UID (rodar: id -u para obter) ───────────────────────────────────
AIRFLOW_UID=1000

# ── Usuário/senha do Airflow web de dev ─────────────────────────────────────
DEV_AIRFLOW_USER=admin
DEV_AIRFLOW_PASSWORD=admin123

# ── Conexão MSSQL de DEV ─────────────────────────────────────────────────────
# Aponte para o banco/schema de desenvolvimento. Não usar o banco de produção!
# Formato: mssql+pyodbc://USUARIO:SENHA@HOST:PORTA/BANCO?driver=ODBC+Driver+17+for+SQL+Server
DEV_MSSQL_CONN=mssql+pyodbc://sa:SuaSenha@192.168.x.x:1433/orquestra_dev?driver=ODBC+Driver+17+for+SQL+Server

# ── Diretório base dos arquivos .dsx no host ─────────────────────────────────
# Pasta no host que será montada como /opt/airflow/dsx dentro dos containers
AIRFLOW_PROJ_DIR=.
