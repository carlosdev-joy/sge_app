# Ver qual imagem está rodando (confirma que é a antiga)
docker compose ps
docker compose images orquestra-api

# Rebuild + restart apenas da API (sem derrubar o resto)
docker compose build orquestra-api && docker compose up -d --no-deps orquestra-api

# Acompanhar os logs até aparecer "Application startup complete."
docker compose logs -f orquestra-api
docker compose restart ui-nginx

# Pega o script (do clone do repo em prod, ou clona fresh)
git clone https://github.com/carlosdev-joy/sge_app.git /tmp/sge && cd /tmp/sge

# Roda o dumper dentro do container da API (usa a conn de prod automaticamente)
docker cp sql/dump_dados.py orquestra-api:/tmp/dump_dados.py
docker exec orquestra-api python /tmp/dump_dados.py --out /tmp/dump_prod.sql

# Traz o arquivo para o host de prod
docker cp orquestra-api:/tmp/dump_prod.sql ./dump_prod.sql
