# Ver qual imagem está rodando (confirma que é a antiga)
docker compose ps
docker compose images orquestra-api

# Rebuild + restart apenas da API (sem derrubar o resto)
docker compose build orquestra-api && docker compose up -d --no-deps orquestra-api

# Acompanhar os logs até aparecer "Application startup complete."
docker compose logs -f orquestra-api
docker compose restart ui-nginx

# 1. Atualiza a shell de deploy a partir do GitHub (traz o deploy.sh corrigido)
rm -rf /opt/git/sge_app
git clone --depth=1 --branch main https://github.com/carlosdev-joy/sge_app.git /opt/git/sge_app

# 2. Roda a shell nova (ela faz o resto: clona pra tmp, rsync, recria nginx)
bash /opt/git/sge_app/scripts/deploy.sh



# 1. Pegar o nginx.conf corrigido do repo
curl -fsSL https://raw.githubusercontent.com/carlosdev-joy/sge_app/main/ui/nginx.conf \
  -o /opt/airflow/ui/nginx.conf

# 2. Verificar que ficou certo (deve ter @v2spa)
grep -A4 'location /v2/' /opt/airflow/ui/nginx.conf

# 3. Restart simples (só recarrega config, não precisa recriar)
docker compose restart ui-nginx

# 4. Testar
curl -I http://localhost/v2/admin
